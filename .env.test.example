# Copy this file to .env.local and fill in values from a DEDICATED TEST
# Supabase project. Never point these at production.
# See tests/e2e/README.md for full setup instructions.

# From your test project's Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# A user that already exists (and has completed onboarding) in that
# test project, used only by Playwright's auth.setup.ts.
E2E_TEST_USER_EMAIL=
E2E_TEST_USER_PASSWORD=
